{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/scripts/check-workspace.sh\" ] || sh \"$CLAUDE_PROJECT_DIR/scripts/check-workspace.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
